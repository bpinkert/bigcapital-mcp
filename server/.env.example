# Bigcapital MCP server config
# Copy to .env and fill in.

API_BASE_URL=http://your-bigcapital-host

# Auto-refresh: server signs in at startup and on any 401, so tokens never go stale.
BIGCAPITAL_EMAIL=you@example.com
BIGCAPITAL_PASSWORD=your-password

# Optional. If unset, organization_id is taken from the signin response.
BIGCAPITAL_ORGANIZATION_ID=

# Optional override. If set without EMAIL/PASSWORD, the token is used as-is and
# will NOT be auto-refreshed (you'll get 401s after expiry).
# BIGCAPITAL_BEARER_TOKEN=
